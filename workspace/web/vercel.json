{
  "version": 2,
  "builds": [
    { "src": "server/dist/index.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/dist/index.js" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ],
  "env": {
    "DATABASE_URL": "@supabase_connection_string",
    "JWT_SECRET": "your-jwt-secret-change-in-production-2024",
    "JWT_EXPIRES_IN": "7d"
  }
}
