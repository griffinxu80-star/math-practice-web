{
  "version": 2,
  "builds": [
    {
      "src": "workspace/web/server/dist/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "workspace/web/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "workspace/web/server/dist/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "workspace/web/client/$1"
    }
  ],
  "env": {
    "PORT": "3000"
  }
}